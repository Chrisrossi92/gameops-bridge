[Unit]
Description=GameOps Bridge Connector (__SERVER_ID__)
After=network.target gameops-api.service

[Service]
Type=simple
WorkingDirectory=__REPO_ROOT__
Environment=NODE_ENV=production
Environment=GAMEOPS_CONFIG_PATH=__CONFIG_PATH__
Environment=CONNECTOR_SERVER_ID=__SERVER_ID__
Environment=API_BASE_URL=http://127.0.0.1:3001
ExecStart=/usr/bin/env npm --workspace apps/connector run dev
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
